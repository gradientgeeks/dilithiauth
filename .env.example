# ── DilithiAuth Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in all CHANGE_ME placeholders before starting.

# Public base URL of the issuer (must match what's in issued tokens).
DILITHIAUTH_ISSUER=https://dilithiauth.gradientgeeks.tech

# Server listen address inside the container.
DILITHIAUTH_ADDR=:8080

# PostgreSQL connection string (password matched to POSTGRES_PASSWORD below).
DILITHIAUTH_POSTGRES_DSN=postgres://dilithiauth:CHANGE_ME@postgres:5432/dilithiauth?sslmode=disable

# Redis address.
DILITHIAUTH_REDIS_ADDR=redis:6379

# Backend selections.
DILITHIAUTH_SIGSTORE=redis
DILITHIAUTH_AUTHZSTORE=redis
DILITHIAUTH_KEYSTORE=file
DILITHIAUTH_KEYS_DIR=/data/keys

# Session secret for developer portal JWT cookies.
# Generate with: openssl rand -base64 32
DILITHIAUTH_SESSION_SECRET=CHANGE_ME

# Bearer token for /admin/rotate — keep this secret.
DILITHIAUTH_ADMIN_TOKEN=CHANGE_ME

# PostgreSQL superuser password (used by the postgres container).
POSTGRES_PASSWORD=CHANGE_ME

# Management server (internal only, not exposed by Nginx).
MANAGEMENT_ADDR=:9090
MANAGEMENT_API_KEY=CHANGE_ME
MANAGEMENT_POSTGRES_DSN=postgres://dilithiauth:CHANGE_ME@postgres:5432/dilithiauth?sslmode=disable
